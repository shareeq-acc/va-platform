# Application Environment (development, staging, production, test)
ENV=development
LOG_LEVEL=INFO
DOMAIN=localhost

# PostgreSQL credentials
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vapi_platform

# Redis connection URL
REDIS_URL=redis://redis:6379/0

# Vapi Integration API Configuration
VAPI_API_KEY=your-vapi-api-key
VAPI_ASSISTANT_ID=your-assistant-id
VAPI_PHONE_NUMBER_ID=your-phone-number-id

# Google Gemini API key for webhook tool reasoning
GEMINI_API_KEY=your-gemini-api-key

# Self-hosted Grafana.
#
# No defaults any more: `admin` / `admin-secret` used to be the fallback here
# and in docker-compose.yml, and Grafana was published on every interface. A
# default password is the one that is still set a year later, so compose now
# refuses to start without these.
#
# Grafana binds to 127.0.0.1 only and is reached over Tailscale, never the
# public internet.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
# The tailnet address you reach Grafana on, used for links inside the app.
GRAFANA_URL=

# S3-compatible Backups configuration (Optional)
S3_BUCKET=your-s3-backup-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1

# --------------------------------------------------------------------------
# On the server
# --------------------------------------------------------------------------
#
# Which image the stack runs. The update timer does not change this — it pulls
# whatever this tag currently points at, and CI moves the tag on every green
# build of main. Pin a commit sha here to roll back.
IMAGE_TAG=main
