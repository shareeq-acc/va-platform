# Application Environment (development, staging, production, test)
ENV=development
LOG_LEVEL=INFO
# Only used by the local development stack. On the server the hostname lives
# in the shared Caddyfile, not here.
DOMAIN=localhost

# PostgreSQL credentials.
#
# The password has no default on purpose. `postgres`/`postgres` is fine on a
# laptop and is a real account on a shared server, so fill this in rather than
# copying it through.
DB_USER=postgres
DB_PASSWORD=
DB_NAME=vapi_platform

# Redis. Only read outside Docker — compose sets this itself and points at the
# `va-redis` service, so changing it here has no effect on the server.
REDIS_URL=redis://localhost:6379/0

# Vapi Integration API Configuration
VAPI_API_KEY=your-vapi-api-key
VAPI_ASSISTANT_ID=your-assistant-id
VAPI_PHONE_NUMBER_ID=your-phone-number-id

# Google Gemini API key for webhook tool reasoning
GEMINI_API_KEY=your-gemini-api-key

# Self-hosted Grafana.
#
# No defaults any more: `admin` / `admin-secret` used to be the fallback here
# and in docker-compose.yml, and Grafana was published on every interface. A
# default password is the one that is still set a year later, so compose now
# refuses to start without these.
#
# Grafana binds to 127.0.0.1 only and is reached over Tailscale, never the
# public internet.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000

# Let anyone read the dashboards without signing in.
#
# `true` puts every dashboard in this Grafana on the public internet — not
# "public if linked", public — and anything added later is public the moment it
# is saved. Anonymous visitors get the Viewer role: read the graphs, and
# nothing else. Signing in as admin still works and is still the only way to
# change anything.
#
# Worth one look at your panels before switching this on. A metric label
# carrying a request path, an internal hostname or an error string is published
# alongside the graph it labels.
GRAFANA_PUBLIC=false

# The address people reach Grafana on. Grafana builds absolute links from this
# — share URLs, redirects — so left blank it advertises localhost to visitors.
#
# Public:   https://grafana.shareeq.xyz
# Private:  https://<machine>.<your-tailnet>.ts.net:9443
GRAFANA_URL=

# Off-site backups to Cloudflare R2 (optional).
#
# These are the names scripts/backup.sh actually reads. This file used to
# advertise S3_BUCKET / AWS_* instead, which the script ignores — so a filled-in
# .env produced backups that quietly stayed on the same disk as the database.
# All four must be set or the upload is skipped.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=your-r2-bucket
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key

# --------------------------------------------------------------------------
# On the server
# --------------------------------------------------------------------------
#
# Which image the stack runs. The update timer does not change this — it pulls
# whatever this tag currently points at, and CI moves the tag on every green
# build of main. Pin a commit sha here to roll back.
IMAGE_TAG=main
